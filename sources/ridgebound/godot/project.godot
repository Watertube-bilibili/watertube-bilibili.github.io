config_version=5
[application]
config/name="山野之间 · RIDGEBOUND"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/window_width_override=1280
window/size/window_height_override=800
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=0.9
lights_and_shadows/directional_shadow/size=1024
environment/defaults/default_clear_color=Color(0.72,0.79,0.76,1)
[physics]
common/physics_ticks_per_second=60
[debug]
gdscript/warnings/treat_warnings_as_errors=false
