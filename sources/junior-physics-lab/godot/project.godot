config_version=5

[application]
config/name="Inclined Plane Physics"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=16
window/size/viewport_height=16
window/size/window_width_override=16
window/size/window_height_override=16
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=480
common/max_physics_steps_per_frame=32
2d/default_gravity=0.0

[audio]
driver/enable_input=false
