extends SceneTree

var failures=[]
var checks=0
func close(actual, expected, tolerance, message):
	checks+=1
	if actual==null or abs(float(actual)-float(expected))>tolerance: failures.append(message+": got "+str(actual)+", expected "+str(expected))
func check(condition,message):
	checks+=1
	if not condition: failures.append(message)
func _initialize():
	var s=load("res://solvers.gd").new()
	root.add_child(s)
	var r=s.solve("density",{"mass":54,"volume":20})
	close(r.values.density,2.7,.000001,"density")
	r=s.solve("circuit",{"scenario":"series","voltage":6,"resistance":10,"resistance2":20})
	close(r.values.current,.2,.000001,"series current")
	close(r.values.voltage1+r.values.voltage2,6,.000001,"series voltage sum")
	r=s.solve("circuit",{"scenario":"parallel","voltage":6,"resistance":10,"resistance2":20})
	close(r.values.current,.9,.000001,"parallel current")
	check(r.values.equivalentResistance<10,"parallel R below branch")
	r=s.solve("circuit",{"scenario":"shortedBulb","voltage":6,"resistance":10,"resistance2":20})
	close(r.values.voltage1,0,.000001,"shorted bulb voltage")
	close(r.values.current,.3,.000001,"remaining series current")
	r=s.solve("lens",{"scenario":"convex","focal":10,"distance":30})
	close(r.values.imageDistance,15,.000001,"convex real image")
	r=s.solve("lens",{"scenario":"convex","focal":10,"distance":5})
	close(r.values.imageDistance,-10,.000001,"convex virtual image")
	r=s.solve("lens",{"scenario":"convex","focal":10,"distance":10})
	check(r.values.atFocus and r.values.imageDistance==null,"focal singularity")
	r=s.solve("optics",{"scenario":"refraction","angle":60,"n1":1.5,"n2":1})
	check(r.values.tir and r.values.refraction==null,"total internal reflection")
	r=s.solve("thermal",{"scenario":"mixing","mass":1,"initial":20,"mass2":1,"temperature2":80})
	close(r.values.temperature,50,.000001,"thermal equilibrium")
	r=s.solve("phase",{"scenario":"melting","mass":.1,"power":100,"time":100,"initial":-10})
	close(r.values.temperature,0,.000001,"melting plateau")
	check(r.values.phase=="冰水共存","melting state")
	r=s.solve("pressure",{"scenario":"liquid","density":1000,"depth":1})
	close(r.values.liquidPressure,9800,.000001,"hydrostatic pressure")
	r=s.solve("buoyancy",{"scenario":"floating","mass":80,"volume":100,"density":1000})
	close(r.values.fraction,.8,.000001,"floating fraction")
	close(r.values.buoyantForce,r.values.weight,.000001,"floating balance")
	r=s.solve("spring",{"force":11,"stiffness":100,"limit":10})
	check(not r.values.valid and r.values.extension==null,"spring limit")
	r=s.solve("lever",{"force":10,"arm":30,"load":15,"loadArm":20})
	check(r.values.balanced,"lever balance")
	r=s.solve("joule",{"current":2,"resistance":10,"time":60})
	close(r.values.heat,2400,.000001,"Joule heat")
	r=s.solve("sound",{"scenario":"vacuum","medium":"vacuum"})
	check(r.values.travelTime==null and r.values.speed==0,"vacuum silence")
	r=s.solve("emwave",{"frequency":100})
	close(r.values.wavelength,2.99792458,.000001,"MHz conversion")
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
