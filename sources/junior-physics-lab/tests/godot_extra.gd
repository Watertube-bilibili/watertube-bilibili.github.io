extends SceneTree
var failed=[]
var solver
func check(value, expected, tolerance, name):
 if value==null or absf(float(value)-float(expected))>tolerance:failed.append({"name":name,"actual":value,"expected":expected})
func _initialize():call_deferred("run_all")
func run_all():
 solver=load("res://solvers.gd").new()
 root.add_child(solver)
 var r=solver.solve("density",{"scenario":"foil","mass":.27,"area":100,"materialDensity":2.7})
 check(r.values.thickness,.001,1e-10,"foil thickness cm")
 r=solver.solve("density",{"scenario":"air","roomLength":6,"roomWidth":4,"roomHeight":3,"airDensity":1.2})
 check(r.values.mass,86.4,1e-8,"air mass kg")
 r=solver.solve("buoyancy",{"scenario":"cause","area":100,"objectHeight":10,"depth":.2,"density":1000})
 check(r.values.buoyantForce,9.8,1e-8,"pressure difference buoyancy")
 r=solver.solve("thermal",{"scenario":"calorimetry","mass":.05,"capacity":4200,"rise":20,"foodMass":.001})
 check(r.values.heat,4200,1e-8,"water calorimetry J")
 check(r.values.energyPerGram,4.2,1e-8,"energy per g conversion")
 r=solver.solve("household",{"scenario":"design","voltage":6,"resistance1":12,"resistance2":18,"switch1":0,"switch2":1})
 check(r.values.current1,0,1e-8,"open first branch")
 check(r.values.current2,1.0/3,1e-8,"second branch independent")
 r=solver.solve("lens",{"scenario":"telescope","objectiveFocal":40,"eyepieceFocal":5})
 check(r.values.angularMagnification,8,1e-8,"telescope angular magnification")
 r=solver.solve("lens",{"scenario":"microscope","focal":2,"distance":2.4,"eyepieceFocal":5})
 check(r.values.angularMagnification,25,1e-8,"compound microscope")
 r=solver.solve("circuit",{"scenario":"led","voltage":6,"resistance":100,"orientation":"reverse"})
 check(r.values.current,0,1e-8,"reverse LED no breakdown model")
 r=solver.solve("force",{"scenario":"interaction","force":5,"force2":20})
 check(r.values.force2,5,1e-8,"reaction equals action")
 r=solver.solve("optics",{"scenario":"rgb","red":255,"green":255,"blue":0})
 if r.values.hex!="#ffff00":failed.append("RGB additive yellow")
 r=solver.solve("circuit",{"scenario":"open","voltage":6,"resistance":10})
 check(r.values.current,0,1e-8,"open circuit current")
 if r.values.equivalentResistance!=null:failed.append("open circuit has finite equivalent resistance")
 r=solver.solve("buoyancy",{"scenario":"archimedes","mass":80,"volume":100,"density":1000,"fraction":.2})
 check(r.values.netUpward,-.588,1e-8,"light object partly immersed initially accelerates down")
 if not "初始向下" in r.conclusion:failed.append("partial immersion direction")
 r=solver.solve("thermal",{"scenario":"heat-input","heat":840,"mass":.04,"capacity":4200,"initial":20})
 check(r.values.temperature,25,1e-8,"chemical heat input to water temperature")
 r=solver.solve("thermal",{"scenario":"efficiency-input","useful":1000000,"efficiency":25})
 check(r.values.input,4000000,1e-8,"fuel efficiency inverse")
 var pendulum=load("res://pendulum_solver.gd").new()
 root.add_child(pendulum)
 await process_frame
 r=await pendulum.evaluate({"length":1,"angle":5,"mass":.2})
 print("pendulum ",r.values)
 check(r.values.period,TAU*sqrt(1.0/9.8),.025,"small angle pendulum period")
 var r2=await pendulum.evaluate({"length":1,"angle":5,"mass":.5})
 check(r2.values.period,r.values.period,.003,"pendulum mass independence")
 r2=await pendulum.evaluate({"length":2,"angle":5,"mass":.2})
 check(r2.values.period/r.values.period,sqrt(2),.025,"pendulum length relation")
 print(JSON.stringify({"failed":failed}))
 quit(0 if failed.is_empty() else 1)
