# SPDX-License-Identifier: AGPL-3.0-only
extends SceneTree
var checks: int=0
var failures: Array=[]
var fixtures: Array=[]
func verify(value: bool,message: String) -> void:
	checks+=1
	if not value:failures.append(message)
func close(actual: float,expected: float,message: String) -> void:
	verify(absf(actual-expected)<0.000001,message)
func _initialize() -> void:
	var solver=load("res://electrical_review.gd").new()
	var r: Dictionary=solver.evaluate("circuit",{"scenario":"ammeterPractice","voltage":3,"resistance":20,"range":0.6,"connection":"series"})
	close(r.values.actual,0.15,"series ammeter reads U/R")
	close(r.values.needleRatio,0.25,"ammeter pointer fraction matches range")
	fixtures.append({"scenario":"ammeterPractice","params":{"scenario":"ammeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"voltmeterPractice","voltage":3,"resistance":20,"range":3,"connection":"parallel"})
	close(r.values.actual,3,"parallel voltmeter reads load voltage")
	close(r.values.circuitCurrent,0.15,"ideal parallel voltmeter does not alter load current")
	fixtures.append({"scenario":"voltmeterPractice","params":{"scenario":"voltmeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"voltmeterPractice","voltage":12,"range":3,"connection":"series","terminal":"reversed"})
	close(r.values.actual,-12,"series voltmeter takes source voltage even under wrong polarity")
	close(r.values.circuitCurrent,0,"series ideal voltmeter opens load circuit")
	verify(r.values.faults.size()==3,"wrong connection, reversal and overrange faults are retained")
	fixtures.append({"scenario":"voltmeterPractice","params":{"scenario":"voltmeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"ammeterPractice","connection":"parallel"})
	verify(r.values.shortRisk and r.values.actual==null,"parallel ideal ammeter has no finite valid short-circuit reading")
	r=solver.evaluate("circuit",{"scenario":"ammeterPractice","connection":"parallel","energized":false})
	verify(not r.values.shortRisk and r.values.actual==0,"unpowered wrong connection warns about future short, not present current")
	r=solver.evaluate("circuit",{"scenario":"multimeterPractice"})
	verify(r.values.mode=="V" and r.values.connection=="parallel" and r.values.valid,"multimeter solver default is usable voltage measurement")
	fixtures.append({"scenario":"multimeterPractice","params":{"scenario":"multimeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"multimeterPractice","mode":"R","energized":true})
	verify(r.values.actual==null and r.values.display=="禁止测量","ohms mode rejects energized load")
	r=solver.evaluate("circuit",{"scenario":"multimeterPractice","mode":"R","energized":false,"connection":"parallel","resistance":20,"range":100,"terminal":"reversed"})
	close(r.values.actual,20,"passive resistor value unchanged by reversing ohms probes")
	verify(r.values.valid,"isolated resistance reading is valid")
	fixtures.append({"scenario":"multimeterPractice","params":{"scenario":"multimeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"multimeterPractice","mode":"R","energized":false,"connection":"series"})
	verify(r.values.actual==null and r.values.display=="OL","ohms probes in disconnected series loop are open circuit")
	r=solver.evaluate("circuit",{"scenario":"multimeterPractice","mode":"V","terminal":"open"})
	verify(r.values.actual==null and r.values.display=="—","floating voltage leads are not falsely shown as ohms OL")
	fixtures.append({"scenario":"multimeterPractice","params":{"scenario":"multimeterPractice"},"result":r})
	r=solver.evaluate("circuit",{"scenario":"ammeterPractice","terminal":"open","connection":"series"})
	close(r.values.actual,0,"open series ammeter shows zero response")
	close(r.values.circuitCurrent,0,"open series leads stop load current")
	r=solver.evaluate("circuit",{"scenario":"ammeterPractice","terminal":"open","connection":"parallel","voltage":3,"resistance":20})
	close(r.values.circuitCurrent,0.15,"open parallel measurement branch leaves load current intact")
	r=solver.evaluate("magnet",{"scenario":"compassMap","x":2,"y":0,"pole":"N"})
	close(r.values.angle,0,"north pole outside right axial field points right")
	r=solver.evaluate("magnet",{"scenario":"compassMap","x":0,"y":1,"pole":"N"})
	close(absf(r.values.angle),180,"equatorial dipole field points toward south pole")
	r=solver.evaluate("magnet",{"scenario":"compassMap","x":1.5,"y":1,"pole":"N"})
	var angle: float=r.values.angle
	fixtures.append({"scenario":"compassMap","params":{"scenario":"compassMap"},"result":r})
	r=solver.evaluate("magnet",{"scenario":"compassMap","x":1.5,"y":1,"pole":"S"})
	close(absf(wrapf(r.values.angle-angle,-180,180)),180,"magnet reversal rotates needle by 180 degrees")
	r=solver.evaluate("magnet",{"scenario":"compassMap","x":0,"y":0})
	verify(not r.values.valid,"dipole center is excluded rather than dividing by zero")
	r=solver.evaluate("magnet",{"scenario":"craneLoad","current":1,"turns":100,"core":"iron","load":20})
	var force_value: float=r.values.force
	close(r.values.weight,0.196,"crane grams converted to kg for weight")
	fixtures.append({"scenario":"craneLoad","params":{"scenario":"craneLoad"},"result":r})
	r=solver.evaluate("magnet",{"scenario":"craneLoad","current":-1,"turns":100,"core":"iron","load":20})
	close(r.values.force,force_value,"reversing current preserves soft-iron attraction magnitude")
	fixtures.append({"scenario":"craneLoad","params":{"scenario":"craneLoad"},"result":r})
	r=solver.evaluate("magnet",{"scenario":"craneLoad","current":1,"turns":200,"core":"iron","load":20})
	close(r.values.force,4*force_value,"doubling turns quadruples force in the stated unsaturated magnetic circuit")
	verify(r.values.held,"given force exceeds 20g weight at 200 turns")
	fixtures.append({"scenario":"craneLoad","params":{"scenario":"craneLoad"},"result":r})
	r=solver.evaluate("magnet",{"scenario":"craneLoad","current":1,"turns":100,"core":"air","load":20})
	verify(r.values.force<force_value and not r.values.held,"removing core reduces field and load capacity")
	fixtures.append({"scenario":"craneLoad","params":{"scenario":"craneLoad"},"result":r})
	r=solver.evaluate("magnet",{"scenario":"craneLoad","current":0})
	verify(r.values.force==0 and not r.values.held,"zero current releases load in no-remanence model")
	r=solver.evaluate("household",{"scenario":"fuseCompare","material":"alloy","current":2,"diameter":0.3,"time":10})
	var reach: float=r.values.reachTime
	var broken: float=r.values.breakTime
	var total_heat: float=r.values.sensibleEnergy+r.values.latentEnergy
	verify(broken>reach,"latent heat delays fuse interruption beyond reaching melting point")
	verify(r.values.fused and r.values.current==0,"completed fuse interrupts current")
	close(r.values.jouleEnergy,total_heat,"Joule energy stops at the break event")
	verify(r.values.heatingStates.filter(func(a):return a.time>broken).all(func(a):return a.current==0 and absf(a.jouleEnergy-total_heat)<0.000001),"all post-break states stop electrical heating")
	fixtures.append({"scenario":"fuseCompare","params":{"scenario":"fuseCompare"},"result":r})
	r=solver.evaluate("household",{"scenario":"fuseCompare","material":"alloy","current":2,"diameter":0.3,"time":reach})
	verify(r.values.reachedMelting and not r.values.fused,"reaching melting point does not break fuse")
	close(r.values.meltedFraction,0,"melting starts at zero melt fraction")
	fixtures.append({"scenario":"fuseCompare","params":{"scenario":"fuseCompare"},"result":r})
	r=solver.evaluate("household",{"scenario":"fuseCompare","material":"alloy","current":2,"diameter":0.3,"time":(reach+broken)/2})
	close(r.values.meltedFraction,0.5,"mid-latent-energy state is half melted")
	close(r.values.temperature,180,"temperature remains on melting plateau")
	verify(not r.values.fused and r.values.current==2,"partly melted wire remains connected under the stated break rule")
	fixtures.append({"scenario":"fuseCompare","params":{"scenario":"fuseCompare"},"result":r})
	r=solver.evaluate("household",{"scenario":"fuseCompare","current":0,"time":30})
	verify(r.values.breakTime==null and r.values.reachTime==null and not r.values.fused,"zero-current fuse has no fabricated finite event time")
	close(r.values.temperature,20,"zero current has no heating")
	r=solver.evaluate("energy",{"scenario":"solarWater","power":500,"efficiency":20,"mass":0.5,"time":120,"initial":20})
	close(r.values.usefulEnergy,12000,"solar efficiency applied once")
	close(r.values.temperature,20+12000.0/2100,"solar sensible heating example")
	fixtures.append({"scenario":"solarWater","params":{"scenario":"solarWater"},"result":r})
	r=solver.evaluate("energy",{"scenario":"solarWater","power":2000,"efficiency":100,"mass":0.1,"time":600,"initial":20})
	verify(r.values.dry and r.values.temperature==null and r.values.remainingMass==0,"fully vaporized water has no liquid temperature reading")
	close(r.values.usefulEnergy,259600,"water absorbed heat stops at sensible plus vaporization energy")
	close(r.values.availableEnergy,r.values.usefulEnergy+r.values.unmodeledEnergy,"post-dryout input energy is separately accounted, not lost or assigned to absent water")
	verify(r.graph.points.all(func(a):return a[0]<=r.values.dryTime and a[1]<=100),"liquid temperature graph stops at dryout and never exceeds boiling")
	fixtures.append({"scenario":"solarWater","params":{"scenario":"solarWater"},"result":r})
	for zero in [{"power":0,"efficiency":100},{"power":1000,"efficiency":0}]:
		zero.merge({"scenario":"solarWater","initial":20,"time":600})
		r=solver.evaluate("energy",zero)
		verify(r.values.temperature==20 and r.values.usefulEnergy==0 and not r.values.dry,"zero absorbed power leaves water unchanged")
	var file=FileAccess.open("/tmp/electrical-review-cases.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(fixtures))
	print(JSON.stringify({"checks":checks,"failures":failures,"actualGodotFixtures":fixtures.size()}))
	quit(0 if failures.is_empty() else 1)
