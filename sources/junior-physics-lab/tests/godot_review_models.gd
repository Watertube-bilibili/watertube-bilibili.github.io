extends SceneTree

var failures: Array=[]
var checks: int=0
func verify(condition: bool, description: String) -> void:
	checks+=1
	if not condition: failures.append(description)
func close(actual: float,expected: float,description: String) -> void:
	verify(absf(actual-expected)<0.00001,description)
func _initialize() -> void:
	var solver=load("res://solvers.gd").new()
	root.add_child(solver)
	var r=solver.solve("sound",{"scenario":"vacuum","medium":"vacuum","amplitude":3})
	verify(r.sourceGraph.points.any(func(p):return absf(p[1])>1),"vacuum: bell continues vibrating")
	verify(r.graph.points.all(func(p):return p[1]==0),"vacuum: received signal zero")
	r=solver.solve("sound",{"scenario":"airColumn","length_cm":10})
	close(r.values.frequency,850,"closed pipe correct SI conversion")
	var longer=solver.solve("sound",{"scenario":"airColumn","length_cm":20})
	close(r.values.frequency,longer.values.frequency*2,"doubling pipe length halves fundamental")
	for state in ["tight","slack","pinched","broken"]:
		r=solver.solve("sound",{"scenario":"telephone","stringState":state,"amplitude":4})
		close(r.values.receivedAmplitude,4*r.values.relativeReceived,"telephone received amplitude "+state)
		if state=="broken":close(r.values.receivedAmplitude,0,"broken string transmits no modeled vibration")
	r=solver.solve("sound",{"scenario":"bottleStrike","waterLevel":0,"amplitude":0})
	var full=solver.solve("sound",{"scenario":"bottleStrike","waterLevel":100})
	verify(r.values.frequency>full.values.frequency,"given struck-bottle model lowers pitch with added water")
	verify(r.sourceGraph.points.all(func(p):return p[1]==0),"zero excitation stops vibration")
	r=solver.solve("sound",{"scenario":"ruler","length":8,"amplitude":2})
	var long_ruler=solver.solve("sound",{"scenario":"ruler","length":16,"amplitude":2})
	close(r.values.frequency,long_ruler.values.frequency*4,"cantilever inverse length squared")
	r=solver.solve("force",{"scenario":"ruler","force":0.2,"position":15,"direction":1})
	var reversed=solver.solve("force",{"scenario":"ruler","force":0.2,"position":15,"direction":-1})
	close(r.values.deflection,-reversed.values.deflection,"reversing load reverses steel ruler deflection")
	r=solver.solve("phase",{"scenario":"melting","material":"water","mass":0.1,"power":100,"time":300,"initial":-10})
	var plateau=r.phaseStates.filter(func(state):return state.temperature==0)
	verify(plateau.size()>2,"melting timeline includes plateau")
	verify(plateau[-1].fraction>plateau[0].fraction,"ice melts while plateau temperature stays fixed")
	r=solver.solve("phase",{"scenario":"freezing","material":"water","mass":0.1,"power":100,"time":350,"initial":5})
	plateau=r.phaseStates.filter(func(state):return state.temperature==0)
	verify(plateau.size()>2 and plateau[-1].fraction<plateau[0].fraction,"liquid fraction decreases on freezing plateau")
	r=solver.solve("measurement",{"scenario":"length","value":1.2,"division":0.1,"count":100})
	close(r.values.average,0.012,"paper thickness cumulative reading")
	r=solver.solve("force",{"scenario":"balance","force":5,"force2":5,"direction":-1,"offset":2})
	verify(not r.values.balanced and r.values.netForce==0 and r.values.netTorque!=0,"force couple is not equilibrium")
	r=solver.solve("lens",{"scenario":"convex","focal":10,"distance":30,"cover":50,"screenDistance":15})
	verify(r.values.focused,"screen at image distance is focused")
	close(r.values.relativeTransmission,0.5,"half covering changes transmission")
	close(r.values.imageDistance,15,"covering does not move image")
	r=solver.solve("induction",{"scenario":"motion","field":0.2,"length":0.5,"velocity":2,"angle":90,"closed":false})
	close(r.values.emf,0.2,"moving conductor emf")
	verify(not r.values.inducedCurrentPossible,"open circuit has no sustained current")
	close(r.trajectory[-1][1],2,"imposed motion follows signed speed")
	r=solver.solve("induction",{"scenario":"generator","frequency":0})
	verify(r.rotationStates.all(func(state):return state.angleDeg==0 and state.emf==0),"stationary generator has no rotation/emf")
	r=solver.solve("induction",{"scenario":"generator","frequency":2,"rotationDirection":-1})
	close(r.rotationStates[-1].angleDeg,-720,"generator can reverse rotation")
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
