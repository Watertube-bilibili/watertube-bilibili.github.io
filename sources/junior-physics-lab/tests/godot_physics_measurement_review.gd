# SPDX-License-Identifier: AGPL-3.0-only
extends SceneTree
var failures: Array=[]
var checks=0
func verify(ok: bool,message: String) -> void:
	checks+=1
	if not ok:failures.append(message)
func near(a: float,b: float,message: String) -> void:
	verify(absf(a-b)<1e-8,message)
func _initialize() -> void:
	var solver=load("res://physics_measurement_review.gd").new()
	var shallow=solver.solve("buoyancy",{"scenario":"weighingDepth","mass":270,"volume":100,"bottomDepth":5})
	var full=solver.solve("buoyancy",{"scenario":"weighingDepth","mass":270,"volume":100,"bottomDepth":10})
	var deeper=solver.solve("buoyancy",{"scenario":"weighingDepth","mass":270,"volume":100,"bottomDepth":30})
	var air=solver.solve("buoyancy",{"scenario":"weighingDepth","bottomDepth":-5})
	near(shallow.values.buoyantForce,.49,"partial immersion displaces half the volume")
	near(full.values.buoyantForce,.98,"full immersion displaces 100 cm3")
	near(full.values.apparentWeight,deeper.values.apparentWeight,"fully submerged depth does not change spring reading")
	near(full.values.weight-full.values.apparentWeight,full.values.buoyantForce,"weighing difference equals buoyancy")
	near(air.values.apparentWeight,air.values.weight,"air reading equals gravity")
	var impossible=solver.solve("buoyancy",{"scenario":"weighingDepth","mass":50,"volume":200,"bottomDepth":25,"density":1500})
	verify(not impossible.values.validSuspension and impossible.values.apparentWeight==null,"cannot support buoyant body downwards with upper string")
	var normal=solver.solve("pulley",{"scenario":"efficiencyMeasurement","load":20,"pull":12.5,"height":.5,"ropeDistance":1})
	near(normal.values.efficiency,80,"measured G F h s yields 80 percent")
	var over=solver.solve("pulley",{"scenario":"efficiencyMeasurement","load":20,"pull":5,"height":.5,"ropeDistance":1})
	verify(over.values.efficiency==null and over.values.rawEfficiency==200,"reject efficiency over 100 without clamping raw data")
	var displaced=solver.solve("pulley",{"scenario":"efficiencyMeasurement","height":.5,"ropeDistance":1.5})
	verify(not displaced.values.geometryConsistent and displaced.values.efficiency==null,"two-strand displacement inconsistency flagged")
	var stronger=solver.solve("pulley",{"scenario":"efficiencyMeasurement","load":20,"pull":20,"height":.5,"ropeDistance":1})
	near(stronger.values.efficiency,50,"greater measured pull reduces efficiency for same load and path")
	var contact=solver.solve("molecular",{"scenario":"contactAttraction","surface":"fresh","separator":"none","stage":"released"})
	verify(contact.values.joinedAfterRelease,"fresh flat direct contact can remain joined")
	for condition in ["rough","oxidized"]:
		var rough=solver.solve("molecular",{"scenario":"contactAttraction","surface":condition,"stage":"released"})
		verify(not rough.values.joinedAfterRelease,"surface condition changes contact evidence "+condition)
	var paper=solver.solve("molecular",{"scenario":"contactAttraction","surface":"fresh","separator":"paper","stage":"released"})
	verify(not paper.values.directContact and not paper.values.joinedAfterRelease,"paper prevents lead-lead intimate contact")
	var pressing=solver.solve("molecular",{"scenario":"contactAttraction","stage":"pressed"})
	verify(not pressing.values.joinedAfterRelease,"pressed together alone is not post-release evidence")
	verify(solver.solve("density",{}).is_empty(),"unrelated solver routing returns empty")
	var evidence=solver.solve("buoyancy",{"scenario":"archimedesEvidence"})
	near(evidence.values.buoyantForce,evidence.values.cupFilledWeight-evidence.values.cupEmptyWeight,"independent cup-weight difference equals buoyancy in correct collection")
	verify(evidence.values.validSuspension and evidence.values.validEvidence,"default object can be suspended in the liquid")
	var underfilled=solver.solve("buoyancy",{"scenario":"archimedesEvidence","headroom":50})
	near(underfilled.values.collectedWeight,.49,"underfilled overflow cup loses half of 100 cm3 displacement")
	verify(not underfilled.values.validEvidence,"underfilled cup is not valid evidence against the principle")
	var lost=solver.solve("buoyancy",{"scenario":"archimedesEvidence","lossPercent":20})
	near(lost.values.collectedWeight,.784,"specified twenty percent collection loss reduces collected liquid weight")
	var float_evidence=solver.solve("buoyancy",{"scenario":"archimedesEvidence","mass":80,"volume":100})
	verify(float_evidence.values.apparentWeight==null and not float_evidence.values.validSuspension,"old 80g default cannot be suspended fully under water")
	var factor=solver.solve("buoyancy",{"scenario":"forceFactors","mass":270,"volume":100,"density":500,"fraction":.5})
	near(factor.values.buoyantForce,.245,"density and immersion fraction jointly determine buoyancy")
	var heavier=solver.solve("buoyancy",{"scenario":"forceFactors","mass":500,"volume":100,"density":500,"fraction":.5})
	near(factor.values.buoyantForce,heavier.values.buoyantForce,"mass alone does not change prescribed displacement buoyancy")
	var artifact=FileAccess.open("res://../research/physics-measurement-review-results.json",FileAccess.WRITE)
	artifact.store_string(JSON.stringify({"checks":checks,"failures":failures,"cases":{"shallow":shallow,"full":full,"deeper":deeper,"air":air,"impossible":impossible,"efficiency":normal,"invalidEfficiency":over,"displacementError":displaced,"contact":contact,"paper":paper,"pressing":pressing,"archimedes":evidence,"underfilled":underfilled,"lost":lost,"floatingEvidence":float_evidence,"factor":factor}},"  "))
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
